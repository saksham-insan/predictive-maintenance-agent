# Anthropic / Gemini API Key for LLM Reasoning Module (optional - falls back to local rule-based insights)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Notification Agent Settings (Optional - SMTP email notifications for HIGH-RISK alerts)
NOTIFICATION_EMAIL_TO=administrator@example.com
NOTIFICATION_EMAIL_FROM=alerts@predictive-maintenance.local
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_TIMEOUT=10.0

